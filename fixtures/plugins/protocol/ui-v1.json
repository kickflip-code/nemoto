{
  "hostApiVersion": "1.8.0",
  "minimumUiHostApi": "1.8.0",
  "limits": {
    "requestBytes": 245760,
    "resultBytes": 524288,
    "stateBytes": 65536,
    "eventBytes": 65536,
    "treeBytes": 262144,
    "treeNodes": 1000,
    "treeDepth": 16,
    "childrenPerNode": 100,
    "effectsPerResult": 16,
    "storageBatchesPerResult": 1,
    "snapshotPageBytes": 65536,
    "snapshotPageItems": 100,
    "queuedEvents": 32,
    "inFlightPerInstance": 1,
    "instancesPerPlugin": 2,
    "reductionsPerSecond": 20,
    "reductionsPerMinute": 600,
    "deadlineMs": 1000,
    "textOutputBytes": 131072
  },
  "primitives": ["stack", "grid", "text", "button", "text-input", "date-input", "checkbox", "select", "list", "dialog", "rich-text", "form", "presentation"],
  "effects": ["read.search", "read.entity", "read.relations", "storage.collection.read-page", "storage.collection.query-page", "storage.collection.transact", "storage.document.get", "storage.document.list", "storage.document.transact", "workspace.context", "workspace.open", "output.text-file", "output.clipboard-text", "output.text-buffer", "notice.show"],
  "requirement": {
    "schema": "axiom.plugin-ui",
    "schemaVersion": 1,
    "protocolVersion": 1,
    "treeVersion": 1,
    "effectsVersion": 1,
    "abi": "axiom-wasm-v1",
    "requiredPrimitives": ["stack", "text", "button"],
    "requiredEffects": ["storage.collection.read-page", "storage.collection.transact"]
  },
  "cases": [
    { "name": "minimal composition", "patch": {}, "valid": true },
    { "name": "no effects", "patch": { "requiredEffects": [] }, "valid": true },
    { "name": "new schema", "patch": { "schemaVersion": 2 }, "valid": false },
    { "name": "foreign schema", "patch": { "schema": "other" }, "valid": false },
    { "name": "new protocol", "patch": { "protocolVersion": 2 }, "valid": false },
    { "name": "new tree", "patch": { "treeVersion": 2 }, "valid": false },
    { "name": "new effects", "patch": { "effectsVersion": 2 }, "valid": false },
    { "name": "wrong ABI", "patch": { "abi": "javascript" }, "valid": false },
    { "name": "empty tree vocabulary", "patch": { "requiredPrimitives": [] }, "valid": false },
    { "name": "duplicate primitive", "patch": { "requiredPrimitives": ["text", "text"] }, "valid": false },
    { "name": "HTML escape", "patch": { "requiredPrimitives": ["html"] }, "valid": false },
    { "name": "duplicate effect", "patch": { "requiredEffects": ["read.entity", "read.entity"] }, "valid": false },
    { "name": "private mutation", "patch": { "requiredEffects": ["portfolio.replace"] }, "valid": false },
    { "name": "secret access", "patch": { "requiredEffects": ["storage.device.secrets.get"] }, "valid": false },
    { "name": "caller grant", "patch": { "grantedCapabilities": ["compute.isolated"] }, "valid": false },
    { "name": "caller budget", "patch": { "limits": { "requestBytes": 99999999 } }, "valid": false },
    { "name": "caller module", "patch": { "module": "runtime/other.wasm" }, "valid": false },
    { "name": "missing effects", "patch": { "requiredEffects": null }, "valid": false },
    { "name": "non-integer protocol", "patch": { "protocolVersion": 1.5 }, "valid": false }
  ],
  "compatibility": [
    { "range": "^1.0.0", "compatible": true },
    { "range": "^1.6.0", "compatible": true },
    { "range": "^1.7.0", "compatible": true },
    { "range": "=1.7.0", "compatible": false },
    { "range": ">=1.5.0 <2.0.0", "compatible": true },
    { "range": "=1.6.0", "compatible": false },
    { "range": "<1.7.0", "compatible": false },
    { "range": "^1.8.0", "compatible": true },
    { "range": ">=2.0.0", "compatible": false }
  ]
}
