{
  "name": "nemoto",
  "author": "Joseph Lundström",
  "private": true,
  "license": "MPL-2.0",
  "version": "1.0.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build:viewer && npm run build:app",
    "build:app": "tsc && vite build",
    "build:viewer": "vite build -c vite.export.config.ts",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:release-metadata": "node scripts/check-release-metadata.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "package:installer": "tauri build --bundles nsis",
    "package:portable": "tauri build --features portable --no-bundle",
    "package:msi": "tauri build --bundles msi",
    "package:checksums": "node scripts/generate-release-checksums.mjs",
    "pretest": "npm run build:viewer",
    "verify:core": "npm run check:release-metadata && npm run build && npm test && npm run check:bundle && cargo test --locked --lib --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "framer-motion": "^12.33.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "pako": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.11.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tippy.js": "^6.3.7",
    "zod": "^4.3.6",
    "zundo": "^2.3.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.23",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.10"
  }
}
